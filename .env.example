# Copy to .env (git-ignored) and restart NETVISTA. Every line is optional.
#
# Copilot with Claude (recommended): an API key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
#
# Model (default claude-opus-5-5; claude-sonnet-5-5 or claude-haiku-5-5 are cheaper and faster)
# NETVISTA_AI_MODEL=claude-sonnet-5-5
#
# Without a key, a local Ollama server is used if one is running (any model with tool support,
# e.g. `ollama pull qwen3:8b`). Force a provider, or switch the copilot off:
# NETVISTA_AI_PROVIDER=anthropic|ollama|off
# NETVISTA_OLLAMA_URL=http://127.0.0.1:11434
# NETVISTA_OLLAMA_NUM_CTX=12288
