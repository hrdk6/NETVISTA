{
  "name": "metro-ring",
  "description": "A metro ring of six routers with two chords, the shape of many city and campus networks. Site A (two clients) hangs off m1 and site B (two servers) off m4; the ring gives every flow two directions around it, the chords give shortcuts with less capacity.",
  "defaults": { "bw_mbps": 50, "queue_pkts": 1000 },
  "nodes": [
    { "id": "c1",   "type": "client", "label": "Client 1", "x": 20,  "y": 140 },
    { "id": "c2",   "type": "client", "label": "Client 2", "x": 20,  "y": 330 },
    { "id": "swa",  "type": "switch", "label": "Site A switch", "x": 150, "y": 235 },
    { "id": "m1",   "type": "router", "label": "M1 (site A)", "x": 300, "y": 235 },
    { "id": "m2",   "type": "router", "label": "M2", "x": 450, "y": 70 },
    { "id": "m3",   "type": "router", "label": "M3", "x": 650, "y": 70 },
    { "id": "m4",   "type": "router", "label": "M4 (site B)", "x": 800, "y": 235 },
    { "id": "m5",   "type": "router", "label": "M5", "x": 650, "y": 400 },
    { "id": "m6",   "type": "router", "label": "M6", "x": 450, "y": 400 },
    { "id": "swb",  "type": "switch", "label": "Site B switch", "x": 950, "y": 235 },
    { "id": "srv1", "type": "server", "label": "Server 1", "x": 1080, "y": 140 },
    { "id": "srv2", "type": "server", "label": "Server 2", "x": 1080, "y": 330 }
  ],
  "links": [
    { "a": "c1",  "b": "swa", "bw_mbps": 100, "delay_ms": 0.5 },
    { "a": "c2",  "b": "swa", "bw_mbps": 100, "delay_ms": 0.5 },
    { "a": "swa", "b": "m1",  "bw_mbps": 100, "delay_ms": 0.5 },
    { "a": "m1",  "b": "m2",  "delay_ms": 3 },
    { "a": "m2",  "b": "m3",  "delay_ms": 3 },
    { "a": "m3",  "b": "m4",  "delay_ms": 3 },
    { "a": "m4",  "b": "m5",  "delay_ms": 4 },
    { "a": "m5",  "b": "m6",  "delay_ms": 4 },
    { "a": "m6",  "b": "m1",  "delay_ms": 4 },
    { "a": "m2",  "b": "m5",  "bw_mbps": 20, "delay_ms": 4 },
    { "a": "m1",  "b": "m4",  "bw_mbps": 20, "delay_ms": 6 },
    { "a": "m4",  "b": "swb", "bw_mbps": 100, "delay_ms": 0.5 },
    { "a": "swb", "b": "srv1", "bw_mbps": 100, "delay_ms": 0.5 },
    { "a": "swb", "b": "srv2", "bw_mbps": 100, "delay_ms": 0.5 }
  ],
  "traffic": [
    { "src": "c1", "dst": "srv1", "rate_mbps": 6 },
    { "src": "c2", "dst": "srv2", "rate_mbps": 6 }
  ]
}
